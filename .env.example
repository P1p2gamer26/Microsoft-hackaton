# COFFEE VALUE BRIDGE — Variables de Entorno (.env.example)
# Copie este archivo a .env y ajuste las credenciales reales cuando las disponga.
# Ninguna credencial real debe commitearse al repositorio.

# === BASE DE DATOS POSTGRESQL + POSTGIS ===
POSTGRES_DB=coffee_value_bridge
POSTGRES_USER=cvb_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# === BACKEND SPRING BOOT ===
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8080
JWT_SECRET=pon-aqui-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=86400000
ANALYTICS_SERVICE_URL=http://analytics:8001

# === FRONTEND VITE ===
VITE_API_URL=http://localhost:8080
VITE_DEMO_PASSWORD=Demo2026!
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# === INTEGRACIONES EXTERNAS (OPCIONALES - SIN CLAVE OPERA EN MODO DEMO/MANUAL) ===
# UN Comtrade (https://comtradeapi.un.org)
UN_COMTRADE_API_KEY=
UN_COMTRADE_BASE_URL=https://comtradeapi.un.org/public/v1

# World Bank WITS
WITS_BASE_URL=https://wits.worldbank.org/API/V1
WITS_API_KEY=

# USITC DataWeb
USITC_API_TOKEN=

# ProColombia / FNC (feeds o importaciones autorizadas)
PROCOLOMBIA_FEED_URL=
FNC_DATA_URL=

# FDA Open Data / Cumplimiento Sanitario EE.UU.
FDA_API_KEY=

# Proveedor de Tasas de Cambio (BanRep / ECB / OpenExchangeRates)
FX_API_URL=
FX_API_KEY=

# Ruteo Terrestre GIS (OSRM o GraphHopper)
OSRM_BASE_URL=
GRAPHHOPPER_API_KEY=

# Proveedor LLM para Export Copilot (opcional; sin configurar usa motor regulatorio experto local)
# Opción local sin internet con Ollama + Qwen3 (sin clave):
#   ollama pull qwen3
#   LLM_API_URL=http://127.0.0.1:11434
#   LLM_MODEL=qwen3
# Con LLM_API_URL vacío el Export Copilot responde solo con su motor experto.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# GeoServer (perfil opcional --profile geoserver)
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver_change_me
